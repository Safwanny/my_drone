<?xml version="1.0"?>
<!--
  WEAREFPV JeNo 7, stretched X, nose +x. The frame mesh is the author's
  26-solid frame (CAD front +Y), yawed -90 deg into ROS axes; base_link sits
  at the vehicle CoM. Rotor numbering and spin: see quad_mesh_common.xacro.
-->
<robot name="jeno7" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find my_drone)/urdf/quad_mesh_common.xacro"/>
  <xacro:include filename="$(find my_drone)/urdf/jeno7_params.xacro"/>
  <xacro:include filename="$(find my_drone)/urdf/f450_gazebo.xacro"/>

  <material name="frame_carbon"><color rgba="0.15 0.15 0.17 1.0"/></material>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${mass_base}"/>
      <inertia ixx="${body_ixx}" ixy="0.0" ixz="0.0"
               iyy="${body_iyy}" iyz="0.0"
               izz="${body_izz}"/>
    </inertial>

    <visual>
      <origin xyz="${cad_offset}" rpy="0 0 ${-pi/2}"/>
      <geometry>
        <mesh filename="package://my_drone/meshes/jeno7/Jeno7_frame.stl" scale="${mesh_scale}"/>
      </geometry>
      <material name="frame_carbon"/>
    </visual>
    <xacro:quad_motor_visuals/>

    <!-- Plate stack (CAD bottom plate 97 x 217 mm, z 0-40 mm). -->
    <collision>
      <origin xyz="0 0 -0.0190" rpy="0 0 0"/>
      <geometry><box size="0.217 0.097 0.040"/></geometry>
    </collision>
  </link>

  <xacro:quad_rotors/>

  <xacro:f450_gazebo_plugins/>

</robot>
