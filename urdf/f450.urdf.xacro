<?xml version="1.0"?>
<!--
  F450 quadcopter, X configuration.

  Rotor layout, viewed from above, nose pointing +x:

              +x (nose)
                 ^
      rotor_2    |    rotor_0
      (cw)       |      (ccw)
       +x,+y     |     +x,-y
                 |
    +y <=========o=========> -y
                 |
      rotor_1    |    rotor_3
      (ccw)      |      (cw)
       -x,+y     |     -x,-y

  Diagonally opposite rotors spin the same way so their yaw torques cancel
  in hover; differential speed between the two diagonal pairs yaws the
  vehicle. This matches the mixer in the reference ESP32 firmware.
-->
<robot name="f450" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find my_drone)/urdf/f450_params.xacro"/>
  <xacro:include filename="$(find my_drone)/urdf/f450_gazebo.xacro"/>

  <material name="carbon">  <color rgba="0.15 0.15 0.17 1.0"/></material>
  <material name="red_arm"> <color rgba="0.80 0.10 0.10 1.0"/></material>
  <material name="white_arm"><color rgba="0.90 0.90 0.90 1.0"/></material>
  <material name="prop_grey"><color rgba="0.20 0.20 0.20 0.7"/></material>

  <!-- ==================== BODY ====================
       Carries the entire vehicle mass and inertia. The arm and rotor
       links below are deliberately light so nothing is double-counted. -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${mass_base}"/>
      <inertia ixx="${body_ixx}" ixy="0.0" ixz="0.0"
               iyy="${body_iyy}" iyz="0.0"
               izz="${body_izz}"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${body_x} ${body_y} ${body_z}"/></geometry>
      <material name="carbon"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="${body_x} ${body_y} ${body_z}"/></geometry>
    </collision>
  </link>

  <!-- ==================== ARMS ====================
       Four booms at 45 deg, purely visual/structural. DJI colours the
       front pair red and the rear pair white, which makes heading
       obvious in the Gazebo viewport. -->
  <xacro:macro name="arm" params="name yaw colour">
    <link name="arm_${name}">
      <inertial>
        <origin xyz="${arm_len/2} 0 0" rpy="0 0 0"/>
        <mass value="0.001"/>
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
      </inertial>
      <visual>
        <origin xyz="${arm_len/2} 0 0" rpy="0 0 0"/>
        <geometry><box size="${arm_len} ${arm_w} ${arm_h}"/></geometry>
        <material name="${colour}"/>
      </visual>
    </link>
    <joint name="arm_${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child  link="arm_${name}"/>
      <origin xyz="0 0 0" rpy="0 0 ${yaw}"/>
    </joint>
  </xacro:macro>

  <xacro:arm name="fr" yaw="${-pi/4}"    colour="red_arm"/>
  <xacro:arm name="fl" yaw="${ pi/4}"    colour="red_arm"/>
  <xacro:arm name="rl" yaw="${ 3*pi/4}"  colour="white_arm"/>
  <xacro:arm name="rr" yaw="${-3*pi/4}"  colour="white_arm"/>

  <!-- ==================== LANDING GEAR ==================== -->
  <xacro:macro name="leg" params="name x y">
    <link name="leg_${name}">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.001"/>
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
      </inertial>
      <visual>
        <geometry><cylinder radius="${leg_r}" length="${leg_len}"/></geometry>
        <material name="carbon"/>
      </visual>
      <collision>
        <geometry><cylinder radius="${leg_r}" length="${leg_len}"/></geometry>
      </collision>
    </link>
    <joint name="leg_${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child  link="leg_${name}"/>
      <origin xyz="${x} ${y} ${-body_z/2 - leg_len/2}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:leg name="fr" x="0.06"  y="-0.06"/>
  <xacro:leg name="fl" x="0.06"  y=" 0.06"/>
  <xacro:leg name="rl" x="-0.06" y=" 0.06"/>
  <xacro:leg name="rr" x="-0.06" y="-0.06"/>

  <!-- ==================== ROTORS ====================
       Each rotor needs a real continuous joint about Z: the
       MulticopterMotorModel plugin drives that joint's velocity and
       applies the resulting thrust to the link. -->
  <xacro:macro name="rotor" params="number x y">
    <link name="rotor_${number}">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${mass_rotor}"/>
        <!-- Thin disc: Izz = m r^2 / 2, Ixx = Iyy = m r^2 / 4 -->
        <inertia ixx="${mass_rotor * prop_radius * prop_radius / 4}" ixy="0.0" ixz="0.0"
                 iyy="${mass_rotor * prop_radius * prop_radius / 4}" iyz="0.0"
                 izz="${mass_rotor * prop_radius * prop_radius / 2}"/>
      </inertial>
      <visual>
        <geometry><cylinder radius="${prop_radius}" length="${prop_h}"/></geometry>
        <material name="prop_grey"/>
      </visual>
      <!-- No collision on the props: a spinning disc colliding with the
           arms only wastes solver time and can destabilise the sim. -->
    </link>
    <joint name="rotor_${number}_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="rotor_${number}"/>
      <origin xyz="${x} ${y} ${rotor_z}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit effort="100.0" velocity="${max_rot_velocity}"/>
      <dynamics damping="0.0" friction="0.0"/>
    </joint>
  </xacro:macro>

  <xacro:rotor number="0" x="${ rotor_xy}" y="${-rotor_xy}"/>  <!-- front-right, ccw -->
  <xacro:rotor number="1" x="${-rotor_xy}" y="${ rotor_xy}"/>  <!-- rear-left,   ccw -->
  <xacro:rotor number="2" x="${ rotor_xy}" y="${ rotor_xy}"/>  <!-- front-left,  cw  -->
  <xacro:rotor number="3" x="${-rotor_xy}" y="${-rotor_xy}"/>  <!-- rear-right,  cw  -->

  <!-- ==================== PLUGINS ==================== -->
  <xacro:f450_gazebo_plugins/>

</robot>
