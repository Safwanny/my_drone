<?xml version="1.0"?>
<!--
  F450 quadcopter parameters, derived from the BOM of
  https://github.com/pratikPhadte/ESP32-Flight-controller-
  (resources/Esp32 f450 frame quadcopter BOM.xlsx)

  Every tunable number lives here. Nothing else should hard-code a constant.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==================== MASS BUDGET (kg) ==================== -->
  <!-- F450/Q450 PCB frame kit                                 282 g -->
  <!-- A2212 1000KV motors           4 x  53 g               = 212 g -->
  <!-- SimonK 30A ESCs               4 x  25 g               = 100 g -->
  <!-- Orange 8045 ABS props         4 x  10 g               =  40 g -->
  <!-- Orange 3S 2200mAh 40C LiPo                              185 g -->
  <!-- FS-iA10B receiver                                        20 g -->
  <!-- ESP32 DevKit + MPU-6050 + 5x7 perfboard + wiring         42 g -->
  <!-- Zipties / tape / misc                                    20 g -->
  <!--                                            All-up: ~= 901 g   -->
  <xacro:property name="mass_total"   value="0.90"/>

  <!-- Mass split between the composite body and the spinning rotors.
       The rotor links must carry a little real mass and inertia so the
       physics engine can integrate their joints, but they are kept tiny
       so that base_link effectively holds the whole vehicle inertia. -->
  <xacro:property name="mass_rotor"   value="0.010"/>
  <xacro:property name="mass_base"    value="${mass_total - 4*mass_rotor}"/>

  <!-- ==================== GEOMETRY (m) ==================== -->
  <!-- F450 = 450 mm motor-to-motor diagonal -> 225 mm radius.
       In X configuration each rotor sits at 225/sqrt(2) = 159 mm on both axes. -->
  <xacro:property name="arm_radius"   value="0.225"/>
  <xacro:property name="rotor_xy"     value="0.15910"/>
  <xacro:property name="rotor_z"      value="0.023"/>

  <xacro:property name="body_x"       value="0.16"/>
  <xacro:property name="body_y"       value="0.16"/>
  <xacro:property name="body_z"       value="0.06"/>

  <xacro:property name="arm_len"      value="0.19"/>
  <xacro:property name="arm_w"        value="0.025"/>
  <xacro:property name="arm_h"        value="0.010"/>

  <!-- 8045 prop = 8 inch diameter -> 0.1016 m radius -->
  <xacro:property name="prop_radius"  value="0.1016"/>
  <xacro:property name="prop_h"       value="0.005"/>

  <!-- Landing gear, so the model rests on skids rather than on its belly -->
  <xacro:property name="leg_len"      value="0.10"/>
  <xacro:property name="leg_r"        value="0.008"/>

  <!-- ==================== INERTIA (kg m^2) ====================
       Composite of: centre box (frame plates + battery + FC, 0.45 kg,
       0.16 x 0.16 x 0.06 m), 4 arms as rods (0.03 kg, 0.19 m), and
       4 motor/ESC point masses (0.078 kg at r = 0.225 m).

         Ixx = Iyy ~= 0.0098      Izz ~= 0.0192

       Sanity check: Izz ~= 2 * Ixx, which is correct for a planar quad. -->
  <xacro:property name="body_ixx"     value="0.0098"/>
  <xacro:property name="body_iyy"     value="0.0098"/>
  <xacro:property name="body_izz"     value="0.0192"/>

  <!-- ==================== ROTOR / MOTOR MODEL ====================
       A2212 1000KV on 3S (11.1 V) with an 8045 prop produces roughly
       4.5 N (~460 gf) of static thrust at about 890 rad/s.

         motor_constant kT = 4.5 / 890^2 = 5.7e-6  N s^2 / rad^2

       Four motors give ~18 N against 8.83 N of weight, i.e. a
       thrust-to-weight ratio of about 2.0:1 and hover near 50% throttle.
       (8045 props are small for a 450 frame, 1045 is typical, which
       is why T/W lands at 2.0 rather than 2.5+.) -->
  <xacro:property name="motor_constant"    value="5.7e-6"/>
  <xacro:property name="moment_constant"   value="0.016"/>
  <xacro:property name="max_rot_velocity"  value="1000"/>
  <xacro:property name="rotor_drag_coeff"  value="8.06428e-05"/>
  <xacro:property name="rolling_moment_coeff" value="1.0e-6"/>
  <xacro:property name="time_constant_up"   value="0.0125"/>
  <xacro:property name="time_constant_down" value="0.025"/>

  <!-- Joint (visual) speed = real rotor speed / this. Thrust is computed
       from the real speed, so this only affects what the eye sees. -->
  <xacro:property name="rotor_slowdown_sim" value="10"/>

  <!-- ==================== VELOCITY CONTROLLER ====================
       Gains scaled for this 0.90 kg, Ixx=0.0098 kg m^2 airframe. -->
  <xacro:property name="velocity_gain"     value="2.7 2.7 2.7"/>
  <xacro:property name="attitude_gain"     value="2.0 2.0 0.15"/>
  <xacro:property name="angular_rate_gain" value="0.4 0.4 0.18"/>
  <xacro:property name="max_linear_accel"  value="3 3 3"/>
  <xacro:property name="max_linear_vel"    value="5 5 3"/>
  <xacro:property name="max_angular_vel"   value="3 3 2"/>

  <!-- ==================== TOPICS ==================== -->
  <xacro:property name="robot_ns"     value="f450"/>

</robot>
