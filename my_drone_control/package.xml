<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>my_drone_control</name>
  <version>0.4.0</version>
  <maintainer email="safwan.shaikh@gmail.com">safwan</maintainer>
  <license>Apache-2.0</license>
  <description>
    Cascaded multicopter flight controller (position, velocity, attitude,
    rate, mixer). The control maths is a ROS-free header; the node wraps it.
  </description>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>eigen</build_depend>
  <build_export_depend>eigen</build_export_depend>

  <depend>rclcpp</depend>
  <depend>actuator_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tinyxml2_vendor</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
