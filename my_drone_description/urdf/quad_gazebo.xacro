<?xml version="1.0"?>
<!--
  Gazebo Harmonic (gz-sim 8) plugin blocks, shared by every quad in this
  package. All numbers come from <drone>_params.xacro.

  MulticopterMotorModel x4 turns a commanded rotor velocity into thrust and
  drag torque (the "ESC + motor + prop" model). The commands come from
  PX4. Then the sensors and the exact-state odometry.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============ Motor model, instantiated once per rotor ============ -->
  <xacro:macro name="motor_plugin" params="number direction">
    <gazebo>
      <plugin filename="gz-sim-multicopter-motor-model-system"
              name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>${robot_ns}</robotNamespace>
        <jointName>rotor_${number}_joint</jointName>
        <linkName>rotor_${number}</linkName>
        <turningDirection>${direction}</turningDirection>
        <timeConstantUp>${time_constant_up}</timeConstantUp>
        <timeConstantDown>${time_constant_down}</timeConstantDown>
        <maxRotVelocity>${max_rot_velocity}</maxRotVelocity>
        <motorConstant>${motor_constant}</motorConstant>
        <momentConstant>${moment_constant}</momentConstant>
        <commandSubTopic>command/motor_speed</commandSubTopic>
        <motorNumber>${number}</motorNumber>
        <rotorDragCoefficient>${rotor_drag_coeff}</rotorDragCoefficient>
        <rollingMomentCoefficient>${rolling_moment_coeff}</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/${number}</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>${rotor_slowdown_sim}</rotorVelocitySlowdownSim>
      </plugin>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="quad_gazebo_plugins" params="">

    <xacro:motor_plugin number="0" direction="ccw"/>
    <xacro:motor_plugin number="1" direction="ccw"/>
    <xacro:motor_plugin number="2" direction="cw"/>
    <xacro:motor_plugin number="3" direction="cw"/>

    <!-- ============ Odometry: the exact state (ground truth) ============ -->
    <gazebo>
      <plugin filename="gz-sim-odometry-publisher-system"
              name="gz::sim::systems::OdometryPublisher">
        <odom_frame>odom</odom_frame>
        <robot_base_frame>base_link</robot_base_frame>
        <dimensions>3</dimensions>
        <odom_publish_frequency>50</odom_publish_frequency>
      </plugin>
    </gazebo>

    <!-- ============ Rotor joint states, so RViz can spin the props ============ -->
    <gazebo>
      <plugin filename="gz-sim-joint-state-publisher-system"
              name="gz::sim::systems::JointStatePublisher"/>
    </gazebo>

    <!-- ============ Sensors ============
         Names and the default gz topics
         (/world/<world>/model/<model>/link/base_link/sensor/<name>/<type>)
         are what PX4's gz_bridge subscribes to; the ROS bridge maps them to
         short ROS names. Noise is copied from PX4's x500 (x500_base), so
         sim sensors are as clean as the stock PX4 drone's. -->

    <!-- IMU, noise as an IIM42653 (as the x500). Orientation is off: gz
         would fill it with the true attitude. -->
    <gazebo reference="base_link">
      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <gz_frame_id>base_link</gz_frame_id>
        <imu>
          <enable_orientation>false</enable_orientation>
          <!-- 0.05 deg/s -->
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.0008726646</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.0008726646</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.0008726646</stddev></noise></z>
          </angular_velocity>
          <!-- 0.65 mg x/y, 0.70 mg z -->
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.00637</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.00637</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.00686</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </gazebo>

    <!-- Barometer, noise as a BMP390 (Pa). -->
    <gazebo reference="base_link">
      <sensor name="air_pressure_sensor" type="air_pressure">
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <gz_frame_id>base_link</gz_frame_id>
        <air_pressure>
          <pressure><noise type="gaussian"><mean>0</mean><stddev>3</stddev></noise></pressure>
        </air_pressure>
      </sensor>
    </gazebo>

    <!-- Magnetometer, noise as an IIS2MDC. The world's <magnetic_field> sets
         the field it measures. -->
    <gazebo reference="base_link">
      <sensor name="magnetometer_sensor" type="magnetometer">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <gz_frame_id>base_link</gz_frame_id>
        <magnetometer>
          <x><noise type="gaussian"><stddev>0.0001</stddev></noise></x>
          <y><noise type="gaussian"><stddev>0.0001</stddev></noise></y>
          <z><noise type="gaussian"><stddev>0.0001</stddev></noise></z>
        </magnetometer>
      </sensor>
    </gazebo>

    <!-- GNSS, 10 Hz, exact here as on the x500: PX4's gz_bridge adds its
         own F9P-class noise. So /navsat in ROS is exact. Needs the world's
         <spherical_coordinates>. -->
    <gazebo reference="base_link">
      <sensor name="navsat_sensor" type="navsat">
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <gz_frame_id>base_link</gz_frame_id>
      </sensor>
    </gazebo>

  </xacro:macro>
</robot>
