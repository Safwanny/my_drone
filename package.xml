<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>my_drone</name>
  <version>0.3.0</version>
  <description>
    Quadcopter simulation for ROS 2 Jazzy and Gazebo Harmonic. Custom Drone
    Build 03, a CAD-based 7-inch quad with spinning props, flown by our own
    cascaded flight controller
    (position, velocity, attitude, rate, mixer), with keyboard teleop and
    go-to-goal.
  </description>
  <maintainer email="safwan.shaikh@gmail.com">safwan</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>actuator_msgs</depend>
  <depend>tinyxml2_vendor</depend>
  <build_depend>eigen</build_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <gazebo_ros gazebo_model_path="${prefix}/.."/>
  </export>
</package>
